# Copy to .env and fill in. Never commit .env.
CARTESIA_API_KEY=
ANTHROPIC_API_KEY=

# Speech-to-text (Cartesia Ink, turn detection)
STT_MODEL=ink-2
# Max wait after speech stops before the turn is closed (640-11200).
STT_TURN_END_TIMEOUT_MS=1600
STT_KEYTERMS=appointment,Dr. Sharma,Dr. Iyer,Dr. Khan,OPD,Sanjeevani

# Text-to-speech (Cartesia Sonic). Pick a Hindi voice in the Cartesia playground and paste its id.
TTS_MODEL=sonic-3.6
TTS_VOICE_ID=694f9389-aac1-45b6-b726-9d9369183238
TTS_LANGUAGE=hi
TTS_SPEED=1.0
# neutral | calm | angry | content | sad
TTS_EMOTION=content
TTS_MAX_BUFFER_DELAY_MS=200

# LLM (Claude)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_MAX_TOKENS=1024

# Start the LLM on STT's eager end-of-turn signal (true/false)
SPECULATIVE_LLM=true

METRICS_DIR=logs
